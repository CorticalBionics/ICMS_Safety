addpath(genpath('C:\git\climber\src\VoltageMonitor\utilities'))

%ONLY FOR CRS02B CURRENTLY 

%%% Folder Paths 
baseDir = 'P:\data_raw\human\crs_array\CRS02b\OpenLoopStim'; 
exportDir = "P:\users\tgh28\Experiments\Longitudinal_ICMS\vm_data_oldFormat";

%Get Folders in OpenLoopStim 
folders = dir(baseDir);
folders = folders(~startsWith({folders.name}, '.')); %Remove . 

%Go Through each folder make VMData Struct from the DAQ data 
for i = 1:length(folders)
    
    %Get folder path
    folderName = folders(i).name;
    folderPath = fullfile(baseDir, folderName);

    %Check if there are DAQ files
    daqFiles = dir(fullfile(folderPath, 'DAQ*.mat'));
    if isempty(daqFiles)
        continue
    end

    %Extract Session Information 
    session_parts = split(folderName, '.');
    sessionType = extractAfter(session_parts{1}, 'CRS02b');
    sessionNum = str2double(session_parts{3});
    if strcmp(sessionType, 'Home')
        sessionNum = sessionNum + 10000;
    end

    %Get session data from first DAQ file to check if file exists 
    firstFileName = daqFiles(1).name;
    trial_parts = split(firstFileName, '.');
    sessionDate = extractAfter(trial_parts{5}, 'Rep0000');
    sessionDate = extractBefore(sessionDate, '_');

    if isempty(sessionDate) %Fix for if rep is greater than 9
        sessionDate = extractAfter(trial_parts{5}, 'Rep000');
        sessionDate = extractBefore(sessionDate, '_');
        sessionDate = sessionDate(2:end);
    end

    %Check if this file has already been processed --------

    %Save filename
    sessionDateFormatted = datestr(datenum(sessionDate, 'dd-mmm-yyyy'), 'mm_dd_yyyy'); %#ok<*DATNM,*DATST>
    saveFileName = sprintf('CRS02b%s_session_%s.mat', sessionType, sessionDateFormatted);
    saveFilePath = fullfile(exportDir, saveFileName);

    % % If file already exists, skip this session
    if exist(saveFilePath, 'file')
        fprintf('File already exists: %s. Skipping processing.\n', saveFileName);
        continue 
    end

    %Make one struct for all the trials in the session
    VMData = struct([]);


    %Go through each DAQ file and get data 
    for ii = 1:length(daqFiles)
        fileName = daqFiles(ii).name;
        filePath = fullfile(folderPath, fileName);
        trial_parts = split(fileName, '.');

        setNum = str2double(extractAfter(trial_parts{2}, "Set"));
        blockNum = str2double(extractAfter(trial_parts{3}, 'Block'));
        trialNum = str2double(extractAfter(trial_parts{4}, 'Trial'));

        %%%Get DAQ data for trial------------------------------
        %Load DAQ matlab file
        tdmsdata = load(filePath);
        if ~isfield(tdmsdata, 'tdmsdata')
            continue
        end
        tdmsdata = tdmsdata.tdmsdata; 
    
        if isfield(tdmsdata, 'Data')
             tdmsdata = tdmsdata.Data;
        end
        
        %Find row to get channel number 
        ch = [];
        for row = 1:64
            if ~isempty(tdmsdata(row).snippet)
                ch = [ch, row]; %#ok<*AGROW>
            end
        end

        if  isempty(ch)
            warning('No data found for file: %s', fileName);
            continue
        end
        
        %Get VM data for channel ----------------------------------

        %Determine which timestamp variable exists
        timestamps = cell(1, length(ch));

        %Check if handling multiple chs properly
        if length(ch) > 1
            test = ch;
        end

        for c = 1:length(ch)
            if isfield(tdmsdata(ch(c)), 'timestamps')
                timestamps{c} = tdmsdata(ch(c)).timestamps;
            elseif isfield(tdmsdata(ch(c)), 'timestamps_NSP1')
                timestamps{c} = tdmsdata(ch(c)).timestamps_NSP1;
            else
                warning('No Timestamp Data found for channel %d in file: %s. Skipping.', ch(c), fileName);
                timestamps{c} = []; % Store empty cell if no timestamp data
            end
        end


        %Create cells of data in case of multiple ch
        amplitudes = {tdmsdata(ch).stimAmp};
        waveforms = {tdmsdata(ch).snippet};
        maxV = {tdmsdata(ch).maxV};
        minV = {tdmsdata(ch).minV};

        %Create struct 
        trialStruct = struct( ...
            'SubjectID', 'CRS02b', ...
            'SessionType', 'OpenLoopStim',...
            'SessionLocation', sessionType, ...
            'SessionNum', sessionNum,...
            'SessionDate', sessionDate, ...
            'Set', setNum, ...
            'Block', blockNum, ... 
            'Trial', trialNum, ... 
            'Channels', {ch}, ...
            'Timestamps', {timestamps},...
            'Amplitudes', {amplitudes},...
            'Waveforms',  {waveforms}, ... 
            'maxV', {maxV},...
            'minV', {minV});

        %Add trial data to sessionStruct 
        VMData = [VMData; trialStruct]; 
    end
 

    %If file exists,
    if isempty(VMData) && ~exist(saveFilePath, "file")
        warning('VMData is empty for session %s. Skipping save.', folderName);
        continue
    end

    %Save Session VM Data 
    save(saveFilePath, 'VMData');
    fprintf('Successfully saved: %s\n', saveFileName);
end

